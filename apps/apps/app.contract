// Apps: the view. app.ts answers what it asks for. Colours, fonts,
// sizes and the safe area are left unsaid, so each platform supplies its own:
// the header is the navigation bar, its heading the title, its button a bar item.
use ConvexLive from "@exact/convex"
use takePhotoWithCameraApp, Photo from "@exact/camera"

shape Greeting
  text: string

shape Counter
  count: number

shape IncrementReply
  ok: bool

routes nav
  home "/"

component Apps
  resource greeting = greeting("Apps") as shape Greeting
  resource live = live() as shape ConvexLive else empty(status="connecting")
  resource counter = counter(live.rev) as shape Counter else empty(count=-1)
  mutation incremented as shape IncrementReply
  mutation photo as shape Photo
  derive photoError = match failure(photo) { case some(f) => f.code, case none => "" }
  state liked = false
  state waited = 0
  state wait = 1
  task reconnect when live.status == "closed"
    every(1000, retry)
  task recovered when live.status == "ready" and wait > 1
    after(1000, resetWait)
  action takePicture
    send photo = takePhotoWithCameraApp()
  action like
    liked = not liked
  action increment
    if live.status == "ready" and counter.count >= 0 and not pending(incremented)
      send incremented = increment()
  action retry
    if waited + 1 >= wait
      waited = 0
      wait = min(wait * 2, 16)
      refresh live
    else
      waited = waited + 1
  action resetWait
    wait = 1
    waited = 0
  action reconnectNow
    refresh live
    refresh counter
  view
    main testId="root" navigationKey=`${top(nav).id}` width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationScroll="content" position="absolute" inset=0 display="flex" flex-direction="column"
          header display="flex" align-items="center"
            text "Camera Notes" role="heading" aria-level=1 flex=1
            button press=like aria-label=(liked ? "Unlike" : "Like") testId="like"
              image (liked ? "symbol:heart-fill" : "symbol:heart")
          scroll id="content" flex=1 min-height=0 padding=16
            column gap=12 align-items="flex-start"
              text "Capture a moment" role="heading" aria-level=2 font="-exact-title2"
              text "Take a photo and preview it here."
              button press=takePicture disabled=pending(photo) buttonStyle="filled" testId="take-photo"
                text (pending(photo) ? "Opening camera…" : "Take photo")
              match photo
                case some(p)
                  image p.path width=280 height=280 object-fit="contain" alt="Your captured photo" testId="photo-preview"
                case none
                  text "Your photo will appear here." testId="photo-placeholder"
              if photoError == "AbortError"
                text "No photo was taken. You can try again." testId="photo-cancelled"
              if photoError == "NotAllowedError"
                text "Camera access is off. Allow it in your device or browser settings, then try again." testId="photo-denied"
              if photoError != "" and photoError != "AbortError" and photoError != "NotAllowedError"
                text "Could not open the camera. Please try again." testId="photo-error"
              text greeting.text testId="greeting"
              text "Live counter" role="heading" aria-level=2 font="-exact-title2"
              text (live.status == "closed" ? "Disconnected. Reconnecting…" : live.status == "failed" or failed(counter) ? "Could not load the counter" : live.status == "ready" and counter.count >= 0 ? "Connected to Convex" : "Connecting to Convex…") testId="convex-status"
              if counter.count >= 0
                text `${counter.count}` font="-exact-large-title" testId="convex-count"
              button press=increment disabled=(live.status != "ready" or counter.count < 0 or pending(incremented)) buttonStyle="filled" testId="convex-increment"
                text (pending(incremented) ? "Saving…" : "Increment")
              if failed(incremented)
                text "Could not save the count. Try again." color="-exact-system-red" testId="convex-error"
              if live.status == "failed" or failed(counter)
                button press=reconnectNow
                  text "Retry connection"
